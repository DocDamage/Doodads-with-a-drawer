{
  "name": "docs-doodads",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "Doc's Doodads: visual asset workspace and doodad editor for RPG Maker MZ",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "shortcuts": "npm run build && node scripts/shortcuts.js",
    "strings": "node scripts/strings.js",
    "check": "node scripts/build.js --check && node --check Docs-Doodads.js",
    "test": "node scratch/run-tests.js",
    "verify": "node scratch/verify-project.js",
    "coverage": "c8 --reporter=text --reporter=json-summary --include=Docs-Doodads.js --check-coverage --lines=85 --statements=85 --functions=80 --branches=75 node scratch/run-tests.js",
    "icons": "node scripts/icons.js",
    "fonts": "node scripts/fonts.js",
    "deploy": "node scripts/deploy.js",
    "package": "node scripts/package.js",
    "lint": "eslint Docs-Doodads.js scripts scratch eslint.config.js"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "eslint": "9.13.0",
    "globals": "15.11.0"
  }
}
